{
  "description": "Send a PushGenius push on Stop, StopFailure, Notification and UserPromptSubmit. Each event is switched on or off by the plugin's push_on_* options; the script exits early for events that are off.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/push.sh",
            "args": [],
            "async": true,
            "timeout": 20
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|agent_needs_input|quota_auto_resume_fired|quota_auto_resume_stale|quota_auto_resume_disabled",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/push.sh",
            "args": [],
            "async": true,
            "timeout": 20
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/push.sh",
            "args": [],
            "async": true,
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/push.sh",
            "args": [],
            "async": true,
            "timeout": 20
          }
        ]
      }
    ]
  }
}
