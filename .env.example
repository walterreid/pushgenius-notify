# Copy to .env or .env.local (both gitignored). Used by scripts/test-push.sh and by the hooks when
# the plugin is loaded with `claude --plugin-dir` (no config dialog).
# When installed from a marketplace, Claude Code prompts for these instead.
PUSHGENIUS_APP_ID=            # optional; the REST key already selects the app
PUSHGENIUS_API_KEY=
PUSHGENIUS_USER_ID=me
# PUSHGENIUS_QUIET_SECONDS=0
# Per-event switches for .env use (plugin installs set these in /config instead):
# PUSHGENIUS_PUSH_ON_STOP=true  PUSHGENIUS_PUSH_ON_ERROR=true  PUSHGENIUS_PUSH_ON_NEEDS_YOU=true
# PUSHGENIUS_PUSH_ON_IDLE=false PUSHGENIUS_PUSH_ON_QUOTA=true  PUSHGENIUS_PUSH_ON_PROMPT=false
